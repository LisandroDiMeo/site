# Copy this file to .env (local dev) or .env.production (Cloudflare Pages build)
# and fill in the values for your environment. See docs/deployment.md for details.

VITE_APP_TITLE=Lisandro's Site

# "local" enables the posts API and filesystem/NAS photos; "cloud" disables posts entirely
VITE_DEPLOYMENT_TYPE=local

# Posts API base URL. Leave empty for cloud deployments (posts are disabled there).
VITE_API_BASE_URL=http://localhost:8090

# "filesystem" | "static" - how photos are served
VITE_PHOTOS_MODE=filesystem
VITE_LOCAL_PHOTOS_PATH=/assets/photos

# Public URL of the external NAS photo server, used in cloud deployments
VITE_EXTERNAL_PHOTOS_URL=

# Base path for the built app (cloud deployments)
VITE_BASE_URL=/
